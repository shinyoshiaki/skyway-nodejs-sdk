{
  "name": "@shinyoshiaki/skyway-nodejs-sdk",
  "description": "The unofficial Next Generation NodeJs SDK for SkyWay",
  "keywords": [
    "webrtc",
    "skyway",
    "conferencing"
  ],
  "version": "1.15.6",
  "homepage": "https://skyway.ntt.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinyoshiaki/skyway-nodejs-sdk.git"
  },
  "license": "MIT",
  "author": "shinyoshiaki2012@gmail.com",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/packages/room/src/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "zx bundle.mjs",
    "compile": "run-s compile:type compile:esm compile:cjs",
    "compile:type": "rm -rf dist && tsc -p tsconfig.build.json",
    "compile:esm": "esbuild src/index.ts --bundle --platform=node --format=esm --target=es2020 --outfile=dist/index.mjs",
    "compile:cjs": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=es2020 --outfile=dist/index.js",
    "compile:esbuild": "esbuild src/index.ts --bundle --format=esm --target=es6 --outfile=dist/index.mjs",
    "compile:tsc": "rm -rf dist && tsc -p tsconfig.build.json",
    "doc": "pnpm run doc:html && pnpm run doc:md",
    "doc:html": "rm -rf docs/html && typedoc --excludePrivate --disableSources --excludeInternal --tsconfig ./tsconfig.build.json --out docs/html ./src/index.ts ",
    "doc:md": "rm -rf docs/md && typedoc --excludePrivate --disableSources --excludeInternal --tsconfig ./tsconfig.build.json --out docs/md --plugin typedoc-plugin-markdown ./src/index.ts ",
    "test": "pnpm run e2e",
    "e2e": "npm-run-all -p jest test-large test-extra",
    "format": "eslint ./src --fix && eslint ./tests --fix",
    "graph": "dependency-cruiser --include-only '^src' --output-type dot src | dot -T svg > docs/dependencygraph.svg",
    "jest": "jest",
    "license": "zx ../../scripts/license.mjs @skyway-sdk/room",
    "lint": "eslint ./src --fix && eslint ./tests --fix",
    "publish:npm": "pnpm run build && pnpm publish --access public",
    "test-extra": "vitest --config vitest.extra.ts run ./tests/extra",
    "test-extra:dev": "vitest --config vitest.extra.ts --browser.headless=false run ./tests/extra",
    "test-large": "vitest --config vitest.large.ts run ./tests/large",
    "test-large:dev": "vitest --config vitest.large.ts --browser.headless=false run ./tests/large",
    "type": "pnpm run type:main",
    "type:main": "tsc --noEmit -p ./tsconfig.json",
    "type:prod": "tsc --noEmit -p ./tsconfig.build.json",
    "watch": "npm-run-all --parallel watch:tsc watch:esbuild",
    "watch:esbuild": "esbuild src/index.ts --bundle --watch --format=esm --target=es2020 --outfile=dist/index.mjs",
    "watch:tsc": "tsc -p tsconfig.build.json -w"
  },
  "dependencies": {
    "@shinyoshiaki/binary-data": "^0.6.1",
    "@shinyoshiaki/ebml-builder": "^0.0.1",
    "@shinyoshiaki/jspack": "^0.0.6",
    "@shinyoshiaki/skyway-nodejs-sdk-core": "^1.6.3",
    "@shinyoshiaki/skyway-nodejs-sdk-sfu-bot": "^1.6.3",
    "@skyway-sdk/common": "^1.5.0",
    "@skyway-sdk/model": "^1.0.1",
    "@skyway-sdk/token": "^1.7.0",
    "msc-node": "^0.0.26",
    "werift": "^0.19.1",
    "multicast-dns": "^7.2.5",
    "@skyway-sdk/core": "^1.12.0",
    "@skyway-sdk/sfu-bot": "^1.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.8",
    "@types/uuid": "^9.0.1",
    "werift-common": "^0.0.2",
    "werift-dtls": "^0.5.4",
    "werift-ice": "^0.0.16",
    "werift-rtp": "^0.8.1",
    "werift-sctp": "^0.0.5",
    "vitest": "^3.0.5"
  }
}