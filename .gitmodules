[submodule "submodules/mediasoup"]
	path = submodules/mediasoup
	# SSH ではなく HTTPS。公開リポジトリなので鍵を持たない環境（fresh clone や
	# CI の checkout）からも取得できるようにする。
	url = https://github.com/shinyoshiaki/mediasoup-client-node.git
	# patches/submodules/ を submodule の working tree に適用して使うため、この
	# submodule は常に dirty になる。gitlink（= remote から取得できる SHA）の変更だけを
	# 親リポジトリの差分として扱う。
	ignore = dirty
