{
  "name": "skyway-nodejs-sdk",
  "private": true,
  "scripts": {
    "build": "lerna run build",
    "build:example": "pnpm run build && lerna run build:example",
    "clean": "pnpm run clean:example && lerna clean -y && rm -rf ./packages/*/dist && rm -rf ./packages/*/node_modules && rm -rf ./packages/*/bundler && rm -rf ./.parcel-cache && rm -rf node_modules",
    "clean:example": "rm -rf ./examples/*/dist && rm -rf ./examples/*/.parcel-cache && rm -rf ./examples/*/node_modules",
    "type": "lerna run type",
    "compile": "lerna run compile && lerna run type",
    "doc": "pnpm run compile && pnpm run doc:update",
    "doc:update": "lerna run doc && zx ./scripts/update-api-reference.mjs && zx ./scripts/insert-gtm-script.mjs",
    "format": "lerna run format",
    "lint": "lerna run lint",
    "graph": "lerna run graph",
    "playground": "cd examples/playground && pnpm run dev",
    "playground-room": "cd examples/playground-room && pnpm run dev",
    "submodule:init": "git -c submodule.third_party/wpt.update=none submodule update --init --recursive",
    "submodule:install": "zx scripts/install_submodules.mjs",
    "test": "cd tests && pnpm test",
    "watch": "lerna run watch",
    "upgrade-interactive": "pnpm dlx npm-check --update",
    "first": "pnpm run submodule:init && pnpm i && pnpm run submodule:install && pnpm run compile",
    "update-mirror": "zx scripts/update-mirror-repo.mjs",
    "debug": "tsx examples/sendrecv/p2p.ts"
  },
  "devDependencies": {
    "@skyway-sdk/room": "^1.12.0",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^4.32.0",
    "@typescript-eslint/parser": "^4.32.0",
    "@vitest/browser": "^3.0.5",
    "buffer": "^5.5.0||^6.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-deprecation": "^1.3.3",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^8.0.0",
    "lerna": "^8.2.2",
    "npm-run-all2": "^6.2.0",
    "organize-imports-cli": "^0.10.0",
    "playwright": "^1.52.0",
    "prettier": "^2.4.1",
    "tsx": "^4.19.4",
    "typedoc": "^0.22.17",
    "typedoc-plugin-markdown": "3.12.1",
    "typescript": "4.9.5",
    "vitest": "^3.0.5",
    "zx": "^8.4.0"
  },
  "engines": {
    "node": "=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-gtk",
      "nx"
    ]
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b"
}
