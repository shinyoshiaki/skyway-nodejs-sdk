{
  "name": "skyway-sdk",
  "private": true,
  "scripts": {
    "build": "lerna run build",
    "build:example": "pnpm run build && lerna run build:example",
    "clean": "pnpm run clean:example && lerna clean -y && rm -rf ./packages/*/dist && rm -rf ./packages/*/node_modules && rm -rf ./packages/*/bundler && rm -rf node_modules",
    "clean:example": "rm -rf ./examples/*/dist && rm -rf ./examples/*/node_modules",
    "type": "lerna run type",
    "compile": "lerna run compile && lerna run type",
    "doc": "pnpm run compile && pnpm run doc:update",
    "doc:update": "lerna run doc && zx ./scripts/update-api-reference.mjs && zx ./scripts/sanitize-docs.mjs && zx ./scripts/insert-gtm-script.mjs",
    "format": "lerna run format",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write --error-on-warnings",
    "graph": "lerna run graph",
    "playground": "cd examples/playground && pnpm run dev",
    "playground-room": "cd examples/playground-room && pnpm run dev",
    "test": "pnpm run compile && zx ./scripts/test.mjs",
    "test:main": "pnpm run compile && zx ./scripts/test-main.mjs",
    "test:no-compile": "zx ./scripts/test.mjs",
    "test:sfu": "pnpm run compile && zx ./scripts/test-sfu.mjs",
    "test:sfu-no-compile": "zx ./scripts/test-sfu.mjs",
    "test:p2p": "pnpm run compile && zx ./scripts/test-p2p.mjs",
    "test:p2p-no-compile": "zx ./scripts/test-p2p.mjs",
    "watch": "lerna run watch",
    "upgrade-interactive": "pnpm dlx npm-check --update",
    "first": "pnpm i && pnpm run compile",
    "update-mirror": "zx scripts/update-mirror-repo.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm i",
    "changeset:version:ci": "pnpm run changeset:version && pnpm run build && pnpm run doc",
    "changeset:publish": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@changesets/cli": "^2.29.8",
    "@types/jasmine": "^4.3.0",
    "@types/jasmine-ajax": "^3.3.5",
    "@types/jest": "^30.0.0",
    "@vitest/browser-playwright": "^4.1.8",
    "buffer": "^5.5.0||^6.0.0",
    "esbuild": "^0.27.0",
    "jasmine-ajax": "^4.0.0",
    "jasmine-core": "^4.4.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lerna": "^9.0.7",
    "npm-run-all2": "^9.0.1",
    "organize-imports-cli": "^0.10.0",
    "playwright": "^1.50.1",
    "ts-jest": "^29.4.9",
    "typedoc": "^0.26.11",
    "typedoc-plugin-markdown": "^4.2.10",
    "typedoc-plugin-zod": "^1.2.1",
    "typescript": "^4.9.5",
    "vitest": "^4.1.8",
    "zx": "^8.4.0",
    "@types/node": "^20.19.0",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.8.1"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
